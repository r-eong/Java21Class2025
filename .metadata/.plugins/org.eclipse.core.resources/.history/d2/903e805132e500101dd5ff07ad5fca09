package ifExample;

import java.io.IOException;

public class Readin {

	public static void main(String[] args) throws IOException {
		// TODO Auto-generated method stub
//		System.in.read() : 키보드로부터 값을 입력받을 수 있다.
		int keycode;
		keycode = System.in.read();
