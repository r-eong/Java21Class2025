package example;

public class DataEx01 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
//		char 데이터 타입 -> 한 음절 표현 반드시 'a' 작은 따옴표 사용
		char ch = 'A';  // 변수란 값(value)을 대입하는 번지 주소를 이름으로 표현
		char ch2 = 'a';
		
		System.out.println(ch);
//		(int)ch : 명시적 형 변환
//		char 인 데이터 타입의 형을 명시해서 int로 변형하는 것
		System.out.println((int)ch);
		System.out.println((int)ch2);
		
		int ch3 = 67;
		System.out.println((char)ch3);
		
//		String : 객체 타입. 반드시 첫 글자는 대문자
//		Integer : Integer 객체 데이터 타입
//		객체 타입의 변수에 저장되는 값은 실제 값이 존재하는 메모리의 번지 주소.
		String str="A";
		System.out.println(str);
		String str2="gun";
		System.out.println(str2);
		System.out.println(System.identityHashCode(str));  // 10진수 출력됨
		String str3="안경";
		System.out.println(str3);
		
//		byte 데이터 타입 -> 1byte = 8bit
//		byte 표현 범위 : -128 ~ 127
//		자바 기본적으로 연산의 메모리 용량이 32bit 이기때문에 
//		기본으로 정수는 int 데이터 타입을 사용.
		byte by1 = 127;
//		byte by2 = 128;  // 오류!
		
//		long 데이터 타입 : 정수(int) 타입의 허용범위를 초과한 경우 
//		반드시 L 또는 l 접미사를 붙인다
//		long lo1 = 1000000000000;
		long lo2 = 1000000000000L;
		long lo3 = 70;
		
	}

}
