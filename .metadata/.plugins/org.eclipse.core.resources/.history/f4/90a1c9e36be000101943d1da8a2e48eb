package example;

public class DataEx01 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
//		char 데이터 타입 -> 한 음절 표현 반드시 'a' 작은 따옴표 사용
		char ch = 'A';  // 변수란 값(value)을 대입하는 번지 주소를 이름으로 표현
		char ch2 = 'a';
		
		System.out.println(ch);
//		(int)ch : 명시적 형 변환
//		char 인 데이터 타입의 형을 명시해서 int로 변형하는 것
		System.out.println((int)ch);
		System.out.println((int)ch2);
		
		int ch3 = 67;
		System.out.println((char)ch3);
		
//		String : 객체 타입. 반드시 첫 글자는 대문자
//		Integer : Integer 객체 데이터 타입
//		객체 타입의 변수에 저장되는 값은 실제 값이 존재하는 메모리의 번지 주소.
		String str = "A";
		System.out.println(str);
		
//		현재 str 변수에 저장된 데이터는 "gun" 가 아니라 
//		"gun" 가 존재하는 메모리 어드레스 주소인 2ff4acd0 이다.
		String str2 = "gun";
		System.out.println(str2);
		System.out.println(System.identityHashCode(str2));  // 10진수 출력됨
		int id = System.identityHashCode(str2);  // 804564176
		System.out.println(Integer.toHexString(id));  // 2ff4acd0
		
		String str3 = "안경";
		System.out.println(str3);
		
//		이스케이프 형식을 이용해서 문자안의 각종 특정문자를 포함시킬 수 있다.
//		이스케이프 형식 : \" -> \뒤의 문자 출력
		String str4 = "나는 \"자바\"를 좋아합니다.";
		System.out.println(str4);
		
		System.out.println("번호\t이름\t직업");
		System.out.print("행 단위 출력");
		System.out.print("다음 줄 개행\n");
		System.out.println("우리는\"바보\"이다.");
		System.out.println("봄\\여름\\가을\\겨울");
		
//		byte 데이터 타입 -> 1byte = 8bit
//		byte 표현 범위 : -128 ~ 127
//		자바 기본적으로 연산의 메모리 용량이 32bit 이기때문에 
//		기본으로 정수는 int 데이터 타입을 사용.
		byte by1 = 127;
//		byte by2 = 128;  // 오류!
		
//		long 데이터 타입 : 정수(int) 타입의 허용범위를 초과한 경우 
//		반드시 L 또는 l 접미사를 붙인다
//		long lo1 = 1000000000000;
		long lo2 = 1000000000000L;
		long lo3 = 70;
		
//		실수형 자료 : Double(8byte), Float(4byte)
//		Float 는 반드시 접미사 F 또는 f 를 붙인다.
		double d1 = 3.14;
//		float flo = 3.14;  // 접미사 F가 없으면 오류출력
		float flo = 3.14F;
	}

}
