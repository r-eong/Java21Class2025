package ifExample;

import java.util.Scanner;

public class IfEx05 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		Scanner scan = new Scanner(System.in);
		
		System.out.println("금액을 입력하시오 >> ");
		int money = scan.nextInt();
		
		System.out.printf("오만원권 : %d 매", money/50000);
		System.out.printf("일만원권 : %d 매", money/10000);
		System.out.printf("오천원권 : %d 매", money/5000);
		System.out.printf("천원권 : %d 매", money/1000);
		System.out.printf("오백원 : %d 매", money/500);
		System.out.printf("백원 : %d 매", money/100);
	}

}
